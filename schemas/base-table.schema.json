{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/base-table.schema.json",
  "title": "底表",
  "description": "底表（Google 表格）的表结构定义。每个工作表在 $defs 里有一个同名定义：properties 的顺序就是列的顺序，属性名就是表头里的中文列名。一行数据按该定义校验。说明页、样例工作簿（templates/base-table-sample.xlsx）、建表脚本都从本文件生成或校验，改列先改这里。本文件公开，不含任何真实数据或账号。",
  "x-sheet-order": ["执行登记", "网页收录", "网页表现", "邮件反馈", "询盘", "动作进度"],
  "x-column-annotations": {
    "description": "这列是什么",
    "x-source": "从哪来",
    "x-writer": "谁写：脚本 = 仓内回流脚本自动写；AI = 对话里的 AI 写；AI（据口述）= 操作者在对话里说一句，AI 查证后代写。操作者不直接在表里打字",
    "examples": "取值示例（样例，不是真实数据）",
    "x-empty": "空着表示什么",
    "x-read": "怎么读、注意什么（可省）"
  },
  "x-conventions": [
    "表头只占第 1 行，从第 2 行起每行一条记录；不合并单元格、不插空行、不加小计行，这样 Looker Studio 才能直接接上。",
    "时刻列一律 UTC，列名里写明「（UTC）」；网页表现的日期按 Google 的太平洋时间切日，列名里写明。",
    "登记编号是把一切串起来的钥匙：执行登记里生成，其他表引用它。",
    "表里只放判断所需的最少个人数据：公司名可以，人名、邮箱地址、电话、地址、邮件正文、询盘备注都不放。"
  ],
  "$defs": {
    "执行登记": {
      "type": "object",
      "description": "我们做过什么：每次在某个渠道发布、更新、改网址、下线，或发出一封邮件，就有一行。这是 L0（已执行）的唯一来源，也是其他所有表回头对账的锚。",
      "x-row": "一次手动动作 = 一行。同一页面先发布、后更新，是两行（两个登记编号）。",
      "x-rows-added": "操作者在对话里说「我发了 / 上线了 / 更新了 / 发出去了」，AI 查证后追加一行；新站仓库合并了影响收录或可见内容的改动，AI 以 PR 为证据补登一行。",
      "x-key": ["登记编号"],
      "required": ["登记编号", "登记时刻（UTC）", "执行日期", "线", "渠道", "动作", "内容说明", "来源", "查证结果"],
      "properties": {
        "登记编号": {
          "type": "string",
          "pattern": "^E-[0-9]{8}-[0-9]{2}$",
          "description": "这次动作的编号，全表唯一。格式 E-年月日-当天序号。",
          "x-source": "AI 写入时按执行日期生成，当天第几条就是几号。",
          "x-writer": "AI",
          "examples": ["E-20261010-01"],
          "x-empty": "不允许空。",
          "x-read": "在其他表里看到同一个编号，就是在说这次动作的后续反馈。"
        },
        "登记时刻（UTC）": {
          "type": "string",
          "format": "date-time",
          "description": "这一行写进表的时刻。",
          "x-source": "AI 写入时自动填。",
          "x-writer": "AI",
          "examples": ["2026-10-10T09:30:00Z"],
          "x-empty": "不允许空。",
          "x-read": "补登的行，登记时刻会晚于执行日期，这是正常的。"
        },
        "执行日期": {
          "type": "string",
          "format": "date",
          "description": "动作实际发生的那天（操作者所在地的日期）。",
          "x-source": "操作者口述；新站 PR 补登时取合并上线日。",
          "x-writer": "AI（据口述）",
          "examples": ["2026-10-10"],
          "x-empty": "不允许空。"
        },
        "线": {
          "type": "string",
          "enum": ["营销", "获客"],
          "description": "这次动作属于营销线还是获客线。",
          "x-source": "AI 按动作内容判断：网站内容、社媒内容归营销；对具体公司的外展邮件归获客。",
          "x-writer": "AI",
          "examples": ["营销"],
          "x-empty": "不允许空。"
        },
        "渠道": {
          "type": "string",
          "enum": ["网站", "邮件", "LinkedIn", "其他平台"],
          "description": "动作发生在哪里。",
          "x-source": "操作者口述。",
          "x-writer": "AI（据口述）",
          "examples": ["网站"],
          "x-empty": "不允许空。",
          "x-read": "「其他平台」时，具体是哪个平台写在内容说明里。"
        },
        "动作": {
          "type": "string",
          "enum": ["新发布", "更新内容", "改网址", "下线", "发出邮件"],
          "description": "做了哪一类事。",
          "x-source": "操作者口述。",
          "x-writer": "AI（据口述）",
          "examples": ["新发布"],
          "x-empty": "不允许空。",
          "x-read": "改网址时，旧网址列必须有值，这样 Google 的数据才能接上。"
        },
        "内容说明": {
          "type": "string",
          "description": "一句话说清发了 / 改了什么。",
          "x-source": "操作者口述，AI 整理成一句。",
          "x-writer": "AI（据口述）",
          "examples": ["样例：发布一篇选型指南"],
          "x-empty": "不允许空。"
        },
        "网址": {
          "type": "string",
          "format": "uri",
          "description": "这次动作对应的公开地址（网站页面、LinkedIn 帖子等）。改网址时填新地址。",
          "x-source": "操作者口述或 AI 从线上找到。",
          "x-writer": "AI（据口述）",
          "examples": ["https://de-linker.com/sample-guide-a/"],
          "x-empty": "这次动作没有公开地址（比如发出一封邮件）。",
          "x-read": "网页收录、网页表现两张表按这个网址接回本行。"
        },
        "旧网址": {
          "type": "string",
          "format": "uri",
          "description": "改网址之前的地址。",
          "x-source": "操作者口述或新站 PR。",
          "x-writer": "AI（据口述）",
          "examples": ["https://de-linker.com/sample-old-c/"],
          "x-empty": "动作不是「改网址」。"
        },
        "收件公司": {
          "type": "string",
          "description": "邮件发给了哪家公司。只写公司名，不写人名和邮箱地址。",
          "x-source": "操作者口述，或 AI 从已发送邮件里读出后只留公司名。",
          "x-writer": "AI（据口述）",
          "examples": ["样例公司甲 GmbH"],
          "x-empty": "这次动作不是邮件。"
        },
        "邮件 Message-ID": {
          "type": "string",
          "description": "这封邮件的唯一编号（邮件头里的 Message-ID）。对方回信时会带上它，所以能自动认出「这是在回哪封信」。",
          "x-source": "邮箱回流脚本在「已发送」里找到这封信后回填。",
          "x-writer": "脚本",
          "examples": ["<sample-001@example.invalid>"],
          "x-empty": "不是邮件；或是邮件但还没在「已发送」里找到（看查证结果）。"
        },
        "外展序列": {
          "type": "string",
          "description": "这封邮件属于哪一组连续跟进的邮件（同一家公司的第 1 封、第 2 封……算一组）。",
          "x-source": "AI 写入时按公司和计划起名。",
          "x-writer": "AI",
          "examples": ["S-样例公司甲"],
          "x-empty": "不是邮件，或是一封单独的信。"
        },
        "第几封": {
          "type": "integer",
          "minimum": 1,
          "description": "这封是该序列里的第几封。",
          "x-source": "操作者口述或 AI 按序列推算。",
          "x-writer": "AI（据口述）",
          "examples": [1],
          "x-empty": "不是序列里的邮件。"
        },
        "计划共几封": {
          "type": "integer",
          "minimum": 1,
          "description": "这组序列计划一共发几封。",
          "x-source": "外展文案交付物里写的计划。",
          "x-writer": "AI",
          "examples": [3],
          "x-empty": "计划里没写封数。此时 AI 不替你决定还要不要再发。"
        },
        "下一封计划日期": {
          "type": "string",
          "format": "date",
          "description": "计划中下一封的发出日期。",
          "x-source": "外展文案交付物里写的计划。",
          "x-writer": "AI",
          "examples": ["2026-10-19"],
          "x-empty": "计划里没写日期，或这已是最后一封。"
        },
        "对应交付物": {
          "type": "string",
          "description": "这次动作用的是哪份交付物（私有资料库里的相对路径）。",
          "x-source": "AI 从台账和交付物目录找到。",
          "x-writer": "AI",
          "examples": ["marketing/05-content/sample-guide-a.md"],
          "x-empty": "这次动作没有对应的交付物（比如临时改了一处错字）。"
        },
        "来源": {
          "type": "string",
          "enum": ["操作者口述", "新站 PR", "补登"],
          "description": "这一行是怎么来的。",
          "x-source": "AI 写入时填。",
          "x-writer": "AI",
          "examples": ["操作者口述"],
          "x-empty": "不允许空。",
          "x-read": "「补登」= 事后补记的历史动作；「新站 PR」= 网站仓库合并的改动，证据是 PR 链接。"
        },
        "查证结果": {
          "type": "string",
          "enum": ["已查证", "查证失败", "未查证（无法公开访问）", "待邮箱接入后查证"],
          "description": "AI 有没有亲眼确认这次动作真的发生了。",
          "x-source": "网页：AI 打开线上地址，看是否能打开、内容是否对得上。邮件：脚本在「已发送」里找。需登录才能看的平台：无法查证。",
          "x-writer": "AI；邮件由脚本回填",
          "examples": ["已查证"],
          "x-empty": "不允许空。",
          "x-read": "只有「已查证」的行，才拿它的后续数据判断效果。"
        },
        "查证证据": {
          "type": "string",
          "description": "查证时看到了什么，一句话。",
          "x-source": "AI 查证时记录。",
          "x-writer": "AI；邮件由脚本回填",
          "examples": ["HTTP 200，页面标题与口述一致"],
          "x-empty": "还没查证。"
        },
        "查证时刻（UTC）": {
          "type": "string",
          "format": "date-time",
          "description": "查证完成的时刻。",
          "x-source": "AI 或脚本查证时自动填。",
          "x-writer": "AI；邮件由脚本回填",
          "examples": ["2026-10-10T09:31:00Z"],
          "x-empty": "还没查证。"
        },
        "备注": {
          "type": "string",
          "description": "以上各列放不下的说明。",
          "x-source": "任何一方。",
          "x-writer": "AI",
          "examples": ["样例，假数据"],
          "x-empty": "没有要补充的。"
        }
      }
    },
    "网页收录": {
      "type": "object",
      "description": "Google 收录了我们的页面没有：每次让 Google 检查一个网址，就记下它当时的回答。对应 L1 里的「已到达」（被收录）。",
      "x-row": "一个网址在某一天的一次检查结果 = 一行。同一个网址每检查一次多一行，所以能看出状态是怎么变的。",
      "x-rows-added": "回流脚本定时运行，检查执行登记里的网址和站点地图里的网址，每个网址每天至多一行。",
      "x-key": ["检查日期", "网址"],
      "required": ["检查日期", "网址", "收录结论", "Google 状态原文", "状态中文说明", "反馈级别", "写入时刻（UTC）"],
      "properties": {
        "检查日期": {
          "type": "string",
          "format": "date",
          "description": "脚本让 Google 检查这个网址的日期。",
          "x-source": "脚本运行日期。",
          "x-writer": "脚本",
          "examples": ["2026-10-14"],
          "x-empty": "不允许空。"
        },
        "网址": {
          "type": "string",
          "format": "uri",
          "description": "被检查的页面地址。",
          "x-source": "执行登记的网址，加上站点地图里的网址。",
          "x-writer": "脚本",
          "examples": ["https://de-linker.com/sample-guide-a/"],
          "x-empty": "不允许空。"
        },
        "登记编号": {
          "type": "string",
          "pattern": "^E-[0-9]{8}-[0-9]{2}$",
          "description": "这个网址最近一次执行登记的编号。",
          "x-source": "脚本按网址到执行登记的「网址」或「旧网址」里找：取执行日期不晚于检查日期的最近一条。",
          "x-writer": "脚本",
          "examples": ["E-20261010-01"],
          "x-empty": "这页在站点地图里，但从没登记过动作（比如上线前就有的老页面）。",
          "x-read": "空着的行也有用：看全站收录情况；但不拿它判断某次动作的效果。"
        },
        "语言": {
          "type": "string",
          "enum": ["英文", "德文"],
          "description": "页面语言。",
          "x-source": "脚本按网址判断：/de/ 开头为德文，其余为英文。",
          "x-writer": "脚本",
          "examples": ["英文"],
          "x-empty": "不允许空。"
        },
        "收录结论": {
          "type": "string",
          "enum": ["已收录", "未收录", "部分问题", "未知"],
          "description": "Google 的总判断，翻成中文。",
          "x-source": "Search Console 网址检查接口返回的 verdict：PASS = 已收录，FAIL = 未收录，PARTIAL = 部分问题，NEUTRAL 或无值 = 未知。",
          "x-writer": "脚本",
          "examples": ["已收录"],
          "x-empty": "不允许空。",
          "x-read": "「已收录」只说明有资格出现在搜索结果里，不保证有人搜到。"
        },
        "Google 状态原文": {
          "type": "string",
          "description": "Google 给出的具体状态，保留英文原文，方便对照官方帮助页。",
          "x-source": "网址检查接口返回的 coverageState。",
          "x-writer": "脚本",
          "examples": ["Submitted and indexed", "Crawled - currently not indexed", "Discovered - currently not indexed"],
          "x-empty": "不允许空。"
        },
        "状态中文说明": {
          "type": "string",
          "description": "上一列翻成一句中文，说明这个状态是什么意思。",
          "x-source": "脚本按固定对照表翻译（对照表随反馈规则维护）。",
          "x-writer": "脚本",
          "examples": ["已提交并已收录"],
          "x-empty": "不允许空；对照表里没有的状态写「未收录到对照表，看原文」。"
        },
        "上次抓取时间（UTC）": {
          "type": "string",
          "format": "date-time",
          "description": "Google 最近一次来抓这个页面的时间。",
          "x-source": "网址检查接口返回的 lastCrawlTime。",
          "x-writer": "脚本",
          "examples": ["2026-10-13T22:05:00Z"],
          "x-empty": "Google 还没来抓过这页。"
        },
        "抓取结果": {
          "type": "string",
          "description": "Google 上次抓取时页面打开得怎么样（成功、404、服务器错误等）。",
          "x-source": "网址检查接口返回的 pageFetchState。",
          "x-writer": "脚本",
          "examples": ["SUCCESSFUL"],
          "x-empty": "Google 还没来抓过这页。"
        },
        "Google 选的规范网址": {
          "type": "string",
          "description": "Google 认定的这页「正式地址」。如果和网址列不同，展示和点击会记在这个地址上。",
          "x-source": "网址检查接口返回的 googleCanonical。",
          "x-writer": "脚本",
          "examples": ["https://de-linker.com/sample-guide-a/"],
          "x-empty": "Google 还没定。"
        },
        "反馈级别": {
          "type": "string",
          "enum": ["L0", "L1"],
          "description": "这次检查说明动作走到了哪一级：已收录 = L1；其余 = 仍在 L0。",
          "x-source": "脚本按收录结论换算。",
          "x-writer": "脚本",
          "examples": ["L1"],
          "x-empty": "不允许空。"
        },
        "写入时刻（UTC）": {
          "type": "string",
          "format": "date-time",
          "description": "这一行写进表的时刻。",
          "x-source": "脚本自动填。",
          "x-writer": "脚本",
          "examples": ["2026-10-14T06:00:00Z"],
          "x-empty": "不允许空。"
        },
        "备注": {
          "type": "string",
          "description": "以上各列放不下的说明。",
          "x-source": "脚本或 AI。",
          "x-writer": "脚本",
          "examples": ["样例，假数据"],
          "x-empty": "没有要补充的。"
        }
      }
    },
    "网页表现": {
      "type": "object",
      "description": "页面在 Google 搜索里被看到、被点击了多少：展示 = L1（已到达），点击 = L2（有互动）。",
      "x-row": "一个网址在一天里的搜索数据 = 一行。",
      "x-rows-added": "回流脚本每天取一次。Google 的数据通常晚 2–3 天，最近两天是初步数，之后会被定稿数覆盖（同一网址同一天始终只有一行）。",
      "x-key": ["日期（太平洋时间）", "网址"],
      "required": ["日期（太平洋时间）", "网址", "展示", "点击", "数据状态", "反馈级别", "写入时刻（UTC）"],
      "properties": {
