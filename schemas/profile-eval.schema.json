{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assertions"],
  "properties": {
    "assertions": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["assertion", "check"],
        "properties": {
          "assertion": {"type": "string"},
          "check": {"type": "string"},
          "evidence": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
